{
  "scan_timeout": {
    "type": "int",
    "default": 5,
    "description": "控件树扫描超时（秒）"
  },
  "max_depth": {
    "type": "int",
    "default": 15,
    "description": "控件树最大递归深度"
  },
  "max_children": {
    "type": "int",
    "default": 120,
    "description": "单个控件最大子节点数"
  },
  "cache_size": {
    "type": "int",
    "default": 128,
    "description": "控件 ID 缓存上限（LRU）"
  },
  "screenshot_annotate": {
    "type": "bool",
    "default": false,
    "description": "截图时是否默认标注控件边框"
  }
}
